{
  "*.{ts,tsx,js,json,yaml,md}": ["oxfmt --no-error-on-unmatched-pattern"],
  "{src,test}/**/*.{ts,tsx}": ["oxlint"],
  ".github/workflows/*.{yml,yaml}": [
    "sh -c 'command -v actionlint >/dev/null || { echo \"actionlint not installed, skipping\"; exit 0; }; actionlint \"$@\"' actionlint"
  ],
  ".github/{workflows/*.{yml,yaml},dependabot.{yml,yaml}}": [
    "sh -c 'command -v zizmor >/dev/null || { echo \"zizmor not installed, skipping\"; exit 0; }; zizmor --offline \"$@\"' zizmor"
  ],
  "*": [
    "sh -c 'command -v typos >/dev/null || { echo \"typos not installed, skipping\"; exit 0; }; typos --force-exclude \"$@\"' typos"
  ]
}
